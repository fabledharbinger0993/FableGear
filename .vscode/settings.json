{
	"task.allowAutomaticTasks": "on",
	"git.autofetch": true,

	// ── CSS linter ─────────────────────────────────────────────────────────
	// FableGear runs in pywebview (Chromium). Suppress Safari/iOS compat noise.
	"css.lint.vendorPrefix": "ignore",
	"css.lint.compatibleVendorPrefixes": "ignore",
	"css.lint.unknownVendorSpecificProperties": "ignore",

	"files.exclude": {
		"**/.venv": true,
		"**/venv": true
	},
	"search.exclude": {
		"**/.venv": true,
		"**/venv": true
	},
	"github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
	"html.validate.styles": false,
	"htmlhint.options": {
		"inline-style-disabled": false
	},
	"python-envs.defaultEnvManager": "ms-python.python:venv",
	"python-envs.defaultPackageManager": "ms-python.python:conda",
	"cSpell.words": [
		"APPLESCRIPT",
		"bitrates",
		"Chromaprint",
		"flac",
		"Hotcue",
		"kbps",
		"keylock",
		"Omnis",
		"Pyrekordbox",
		"Rekit",
		"fablegear",
		"Rekordbox",
		"shellenv",
		"venv",
		"wavesurfer"
	],
	"python.testing.pytestArgs": [
		"venv"
	],
	"python.testing.unittestEnabled": false,
	"python.testing.pytestEnabled": true,
	"sarif-viewer.connectToGithubCodeScanning": "off",

	// ── SonarLint: exclude browser-side JS from analysis ────────────────────
	// FableGear's static/**/*.js targets pywebview's Chromium runtime where
	// idioms like `window`, multi-line `push()`, toast-only catches, and the
	// `dupe.offsetWidth` reflow trick are intentional. SonarLint flags these
	// as stylistic warnings that don't apply to our local-only desktop app.
	// Exclude the whole tree from SonarLint to silence the noise.
	"sonarlint.analysisExcludesStandalone": "static/**/*.js,static/**/*.css,static/**/*.html",
	"files.autoSave": "afterDelay",
	"editor.defaultFormatter": "ms-python.python",
	"chat.agent.maxRequests": 10,
	"editor.formatOnPaste": true,
	"editor.accessibilityPageSize": 10000,
	"npm.enableRunFromFolder": true
}