{
	"task.allowAutomaticTasks": "on",
	"git.autofetch": true,

	// ── CSS linter ─────────────────────────────────────────────────────────
	// FableGear runs in pywebview (Chromium). Suppress Safari/iOS compat noise.
	"css.lint.vendorPrefix": "ignore",
	"css.lint.compatibleVendorPrefixes": "ignore",
	"css.lint.unknownVendorSpecificProperties": "ignore",

	"files.exclude": {
		"**/.venv": true,
		"**/venv": true
	},
	"search.exclude": {
		"**/.venv": true,
		"**/venv": true
	},
	"github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
	"html.validate.styles": false,
	"htmlhint.options": {
		"inline-style-disabled": false
	},
	"python-envs.defaultEnvManager": "ms-python.python:conda",
	"python-envs.defaultPackageManager": "ms-python.python:conda",
	"cSpell.words": [
		"APPLESCRIPT",
		"bitrates",
		"Chromaprint",
		"DJMT",
		"flac",
		"Hotcue",
		"kbps",
		"keylock",
		"Omnis",
		"Pyrekordbox",
		"Rekit",
		"fablegear",
		"Rekordbox",
		"shellenv",
		"venv",
		"wavesurfer"
	],
	"python.testing.pytestArgs": [
		"venv"
	],
	"python.testing.unittestEnabled": false,
	"python.testing.pytestEnabled": true,
	"sarif-viewer.connectToGithubCodeScanning": "off",

	// ── SonarLint: silence stylistic noise in browser-side JS ───────────────
	// FableGear's static/**/*.js targets pywebview's Chromium runtime where
	// `window`, multi-line `push()`, and toast-only catches are intentional.
	// These rules are stylistic, not correctness — disable them globally.
	"sonarlint.rules": {
		"javascript:S7059":  { "level": "off" },  // Prefer globalThis over window
		"javascript:S6582":  { "level": "off" },  // Prefer optional chain
		"javascript:S7758":  { "level": "off" },  // Prefer String#replaceAll()
		"javascript:S7773":  { "level": "off" },  // Use String.raw to avoid escaping \
		"javascript:S7752":  { "level": "off" },  // Do not call Array#push() multiple times
		"javascript:S3358":  { "level": "off" },  // Unexpected negated condition
		"javascript:S2737":  { "level": "off" },  // Catch clauses should do more than rethrow
		"javascript:S1481":  { "level": "off" },  // Unused local variables (handled by editor)
		"javascript:S905":   { "level": "off" },  // Non-empty statements should change control flow or have at least one side-effect (offsetWidth reflow trick)
		"javascript:S2486":  { "level": "off" }   // Either log or rethrow this exception
	}
}