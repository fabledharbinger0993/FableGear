{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useNamingConvention": "off",
        "noNegationElse": "off",
        "useTemplate": "off",
        "useNodejsImportProtocol": "off",
        "useSingleVarDeclarator": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "useLiteralKeys": "off",
        "noForEach": "off",
        "noUselessFragments": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "noUnsafeNegation": "off",
        "noConsole": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "correctness": {
        "noUnusedVariables": "off"
      }
    }
  },
  "overrides": [
    {
      "include": ["static/**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "noNegationElse": "off",
            "useTemplate": "off",
            "useNodejsImportProtocol": "off",
            "useSingleVarDeclarator": "off",
            "noParameterAssign": "off"
          },
          "complexity": {
            "useOptionalChain": "off",
            "useLiteralKeys": "off",
            "noForEach": "off"
          },
          "suspicious": {
            "noGlobalIsNan": "off",
            "noAssignInExpressions": "off",
            "noExplicitAny": "off",
            "noConsole": "off",
            "noEmptyBlockStatements": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "nursery": {
            "all": false
          }
        }
      }
    }
  ]
}
