{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignoreUnknown": true,
    "ignore": ["**/node_modules/**", "**/*.legacy", "ios/**", "packaging/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "include": ["static/**/*.js"],
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noConstAssign": "error",
            "noInvalidConstructorSuper": "error",
            "noUnreachable": "warn"
          },
          "suspicious": {
            "noDoubleEquals": "warn",
            "noDuplicateObjectKeys": "warn",
            "noDuplicateCase": "warn",
            "noFallthroughSwitchClause": "warn",
            "noRedeclare": "warn",
            "noDuplicateParameters": "error"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
