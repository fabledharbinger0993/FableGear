# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Apple IDE local user state
ios/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcuserdatad/
DerivedData/

# Claude Code agent worktrees / scratch space
.claude/

# AI coding tool artifacts (Kilo Code, Qodo, pytest cache)
.kilocode/
.qodo/
.pytest_cache/

# Secrets / config
*.env
.env
.fablegear-agent.env
settings.json

# Setup sentinel (written by setup.sh, local to each machine)
.rekitbox_ready
.fablegear_ready

# Dev mode marker (skips git pull on launch)
.dev

# Runtime sentinels (machine-local, written by launchers)
.dock_launcher_offered

# MCP browser-automation session dumps (never commit)
.playwright-mcp/

# Test artifacts
*.bak
*.tmp
SuperBox.zip
FableGear.zip

# The static folder holds CSS/JS/images only.
# index.html lives ONLY in templates/ and is served by render_template().
# Never commit a copy here — it causes confusion about which file is current.
static/index.html


# Runtime log
fablegear.log
