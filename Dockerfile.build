# FableGear — Docker image for headless server mode and CI dependency testing
#
# NOTE: Docker runs Linux. PyInstaller on Linux cannot produce a macOS .app bundle.
# Use this image to:
#   - Run FableGear as a headless web server (no pywebview window, plain HTTP)
#   - Test Python dependencies and backend routes in CI
#   - Use on a remote machine or home server where a browser is the client
#
# For building a distributable .app, use build_release.sh (macOS only) or
# push a version tag to trigger the GitHub Actions workflow.
#
# Build:  docker build -f Dockerfile.build -t fablegear .
# Run:    docker run --rm -p 5000:5000 -v /your/music:/music fablegear

FROM python:3.11-slim

# Install system dependencies: ffmpeg, chromaprint (fpcalc), build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    chromaprint \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only requirements first for better layer caching
COPY requirements.txt ./

# Install Python dependencies (skip pywebview — no WKWebView on Linux)
RUN python -m pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt || true

# Copy the entire app source
COPY . .

EXPOSE 5000

# Run FableGear as a headless Flask server (no pywebview window)
# The UI is accessible at http://localhost:5000 in any browser
CMD ["python", "-c", "import os; os.environ.setdefault('FABLEGEAR_HEADLESS','1'); from app import app; app.run(host='0.0.0.0', port=5000)"]
